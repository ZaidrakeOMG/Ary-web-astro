---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import StationCard from '../components/StationCard.astro';
import Icon from '../components/Icon.astro';
import { stations } from '../data/site';
---
<SiteLayout title="Nuestras estaciones | ARY Gasolinerías" description="Fotografías y ubicaciones de las siete estaciones ARY y Servicio Apache en La Laguna." active="estaciones">
<PageIntro eyebrow="TU PRÓXIMA PARADA" title="Estamos en" accent="tu camino." description="Elige tu ciudad, encuentra tu estación y abre la ruta en Google Maps. Así de fácil."/>
<section class="section"><div class="wrap"><div class="filter-row"><div class="filters" role="group" aria-label="Filtrar por ciudad">{['Todas','Gómez Palacio','Lerdo','Torreón'].map((city,i)=><button class="filter-button" data-filter={city} type="button" aria-pressed={i===0 ? 'true' : 'false'}>{city}</button>)}</div><label class="station-search"><Icon name="search" size={18}/><span class="sr-only">Buscar estación, ciudad o dirección</span><input id="stationSearch" type="search" placeholder="Busca tu estación" autocomplete="off"/></label></div><p class="results-status" id="stationCount" role="status" aria-live="polite">7 estaciones para seguir avanzando</p><div class="station-grid">{stations.map((station,i)=><StationCard station={station} index={i}/>)}</div><div class="no-results" id="noStations" hidden>No encontramos una estación con esa búsqueda. Prueba otra ciudad o nombre.</div><div class="notice-box">Consulta directamente con la estación sus horarios, servicios y disponibilidad. Las fotografías corresponden a cada ubicación.</div></div></section>
</SiteLayout>
<script>
const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');const cards=document.querySelectorAll<HTMLElement>('.station-card');const input=document.querySelector<HTMLInputElement>('#stationSearch');let city='Todas';
const normalize=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
function filter(){const q=normalize(input?.value.trim()||'');let total=0;cards.forEach(card=>{card.hidden=(city!=='Todas'&&card.dataset.city!==city)||!normalize(card.dataset.search||'').includes(q);if(!card.hidden)total++;});const label=document.getElementById('stationCount');if(label)label.textContent=`${total} ${total===1?'estación disponible':'estaciones disponibles'}`;const empty=document.getElementById('noStations');if(empty)empty.hidden=total>0;}
buttons.forEach(b=>b.addEventListener('click',()=>{city=b.dataset.filter||'Todas';buttons.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));filter();}));input?.addEventListener('input',filter);
</script>
