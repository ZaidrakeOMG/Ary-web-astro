---
import SiteLayout from '../layouts/SiteLayout.astro';
import StationCard from '../components/StationCard.astro';
import {stations} from '../data/site';
const cities=['Todas','Gómez Palacio','Lerdo','Torreón'];
---
<SiteLayout title="Estaciones ARY y Apache | Ubicaciones" description="Ubica las siete estaciones ARY y Servicio Apache en Gómez Palacio, Lerdo y Torreón." active="estaciones">
  <section class="page-hero"><div class="shell page-hero-grid"><div><span class="eyebrow light">Tu próxima parada</span><h1>Donde estés, <span class="accent-gold">hay una ARY.</span></h1><p>Busca por ciudad y encuentra la estación más conveniente para ti. Abre la ruta de tu elección directamente en Google Maps.</p></div><div class="page-hero-img"><img src="/media/ary-5.webp" width="1152" height="864" alt="Estación ARY iluminada" decoding="async" /></div></div></section>
  <section class="section blush" id="lista-estaciones"><div class="shell"><div class="heading-row"><div><span class="eyebrow">Conoce nuestras ubicaciones</span><h2 class="section-title">7 estaciones.<br /><span class="accent">Muchos caminos.</span></h2><p class="section-lead">Filtra por ciudad o consulta todas las ubicaciones publicadas.</p></div></div>
    <div class="filter-row" role="group" aria-label="Filtrar estaciones por ciudad">{cities.map((city,i)=><button type="button" class="filter-button" data-city-filter={city} aria-pressed={i===0?'true':'false'}>{city}</button>)}</div>
    <div class="station-grid" id="station-results">{stations.map(station=><StationCard station={station} />)}</div>
    <p class="notice" style="margin:27px 0 0">Las fotografías corresponden a las ubicaciones proporcionadas por Grupo ARY. Los horarios y servicios pueden variar según cada estación.</p>
  </div></section>
  <script>
    const buttons=document.querySelectorAll<HTMLButtonElement>('[data-city-filter]');
    const cards=document.querySelectorAll<HTMLElement>('.station-card[data-city]');
    buttons.forEach(button=>button.addEventListener('click',()=>{
      const city=button.dataset.cityFilter||'Todas';
      buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
      cards.forEach(card=>card.hidden=city!=='Todas'&&card.dataset.city!==city);
    }));
  </script>
</SiteLayout>
