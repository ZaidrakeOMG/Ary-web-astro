---
import SiteLayout from '../layouts/SiteLayout.astro';import PageIntro from '../components/PageIntro.astro';import Icon from '../components/Icon.astro';import CTA from '../components/CTA.astro';
const cards=[['car','Control de flotillas','Alternativas para organizar el consumo de combustible de tus vehículos y facilitar la gestión de tu operación.'],['card','Tarjeta ARY','Consulta las opciones de identificación y control disponibles para clientes empresariales.'],['receipt','Vales prepagados','Conoce las alternativas de vales para planificar el gasto y atender las necesidades de tu negocio.'],['briefcase','Crédito empresarial','Solicita información sobre los requisitos, evaluación y condiciones de las opciones de crédito.'],['person','Alta fiscal de clientes','Registra tus datos en el portal para solicitar facturas en la estación correspondiente.'],['fuel','Atención en estación','Encuentra productos y servicios complementarios para acompañar el cuidado de tu vehículo.']];
---
<SiteLayout title="Servicios y flotillas | ARY Gasolinerías" description="Control de flotillas, tarjeta ARY, vales, crédito empresarial y facturación." active="servicios">
<PageIntro eyebrow="SOLUCIONES ARY" title="Más para ti." accent="Más para tu negocio." description="Servicios para hacer más sencilla tu ruta diaria y la operación de tus vehículos."/>
<section class="section"><div class="wrap"><div class="services-grid">{cards.map(([icon,title,text],i)=><article class="service-tile"><div class="tile-head"><span class="tile-icon"><Icon name={icon}/></span><span class="tile-number">0{i+1}</span></div><h3>{title}</h3><p>{text}</p><a class="text-link" href={i===4?'/facturacion/?tramite=alta':i===3?'/credito/':'/contacto/'}>Solicitar información <Icon name="arrow" size={18}/></a></article>)}</div></div></section>
<section class="section soft-bg"><div class="wrap split-section"><div><span class="overline">CLIENTES EMPRESARIALES</span><h2>Tu operación,<br/><em>bajo control.</em></h2><p>¿Ya utilizas nuestro servicio para flotillas? Ingresa a tu portal de siempre. Si quieres comenzar, hablemos de las necesidades de tu empresa.</p><div class="button-row"><a class="button button-primary" href="https://www.grupoary.com.mx:4443/" target="_blank" rel="noopener noreferrer">Acceso Flotillas <Icon name="external" size={18}/></a><a class="button button-outline" href="/credito/">Conocer opciones</a></div><p class="tiny" style="margin-top:18px">El acceso a flotillas abre un sistema empresarial independiente.</p></div><img src="/media/ary-2.webp" alt="Estación ARY II en Lerdo" width="1152" height="864" loading="lazy"/></div></section><CTA title="Tu factura también puede ser más sencilla." description="Factura tu ticket o solicita tu alta fiscal desde el portal." href="/facturacion/" label="Ir a facturación"/>
</SiteLayout>
