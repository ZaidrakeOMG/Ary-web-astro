---
import SiteLayout from "../layouts/SiteLayout.astro";
const services = [
  {
    tag: "Para empresas",
    symbol: "◈",
    title: "Control de flotillas y vehículos",
    text: "Conoce las alternativas de Grupo ARY para el seguimiento y la administración del consumo de combustible en flotillas.",
  },
  {
    tag: "Identificación",
    symbol: "▥",
    title: "Código de barras",
    text: "Una opción que forma parte de las herramientas de control descritas por ARY para identificar operaciones y vehículos.",
  },
  {
    tag: "Comodidad",
    symbol: "▣",
    title: "Tarjeta ARY",
    text: "Una alternativa para las operaciones habituales de clientes empresariales, sujeta a las condiciones de contratación.",
  },
  {
    tag: "Control de gasto",
    symbol: "◇",
    title: "Vales prepagados",
    text: "Una opción orientada a organizar consumos según las necesidades y condiciones de tu operación.",
  },
];
---
<SiteLayout
  title="Nuestros servicios | Grupo ARY"
  description="Conoce los servicios de Grupo ARY: control de flotillas, tarjeta ARY, vales prepagados y alternativas para empresas."
  active="servicios"
>
  <section class="page-hero">
    <div class="container page-hero-split">
      <div>
        <span class="eyebrow">Soluciones que te acompañan</span>
        <h1>Más control.<br /><span class="highlight">Más libertad.</span></h1>
        <p>Desde tu carga de combustible hasta la operación de una flotilla, descubre cómo nuestros servicios pueden acompañarte.</p>
        <div class="hero-actions">
          <a class="btn btn-accent" href="/credito/">Conoce las opciones empresariales <span aria-hidden="true">↗</span></a>
          <a class="btn btn-outline" href="/contacto/">Solicitar información</a>
        </div>
      </div>
      <div class="page-hero-media contain">
        <img src="/Images/tarjeta_ARY.png" alt="Tarjeta ARY para clientes" width="780" height="540" decoding="async" />
      </div>
    </div>
  </section>

  <section class="section surface-light">
    <div class="container">
      <span class="eyebrow">Soluciones ARY</span>
      <h2 class="section-title">Servicios para cada necesidad.</h2>
      <p class="section-subtitle">Información general de las alternativas que Grupo ARY presenta para el uso personal y empresarial.</p>
      <div class="value-grid" style="margin-top:34px;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr))">
        {services.map(service => (
          <article class="value-card">
            <span class="value-icon" aria-hidden="true">{service.symbol}</span>
            <span class="pill">{service.tag}</span>
            <h3 style="margin-top:17px">{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container product-split">
      <div class="product-photo">
        <img src="/Images/ary-gasolinerias.png" alt="Identidad visual de gasolinerías ARY" loading="lazy" decoding="async" />
      </div>
      <div>
        <span class="eyebrow">Portal empresarial</span>
        <h2>Tu flotilla.<br /><span class="highlight">Bajo control.</span></h2>
        <p>¿Ya utilizas el servicio para flotillas? Puedes ingresar al portal existente de Grupo ARY. Si apenas deseas comenzar, nuestro equipo puede orientarte.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://www.grupoary.com.mx:4443/" target="_blank" rel="noopener noreferrer">Acceso Flotillas <span aria-hidden="true">↗</span></a>
          <a class="btn btn-outline" href="/credito/">Información de crédito</a>
        </div>
        <p class="muted" style="font-size:.82rem;margin-top:15px">El portal de flotillas abre un servicio independiente del sitio público.</p>
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <div class="feature-band"><div class="feature-band-inner">
        <div><span class="eyebrow" style="color:#ffe0a9">Trámite independiente</span><h2>¿Necesitas facturar?</h2>
          <p>Envía tu ticket o solicita el alta de tus datos fiscales en el portal de facturación de ARY.</p></div>
        <a class="btn btn-accent" href="/facturacion/">Facturación y alta <span aria-hidden="true">↗</span></a>
      </div></div>
    </div>
  </section>
</SiteLayout>
