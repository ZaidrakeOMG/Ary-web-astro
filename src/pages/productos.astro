---
import SiteLayout from '../layouts/SiteLayout.astro';
const products=[
  {tag:'Combustible',title:'Tu próxima carga',text:'Encuentra una estación ARY o Apache conveniente para tu recorrido y conoce su ubicación.',image:'/media/ary-2.webp',alt:'Estación ARY de día'},
  {tag:'Lubricantes',title:'Cuida tu vehículo',text:'Consulta los productos de mantenimiento y lubricantes disponibles en cada establecimiento.',image:'/media/ary-4.webp',alt:'Estación de servicio con surtidores'},
  {tag:'Atención',title:'Más soluciones',text:'Pregunta directamente en tu estación por las alternativas de servicio y productos complementarios.',image:'/media/ary-6.webp',alt:'Estación ARY iluminada por la noche'},
];
---
<SiteLayout title="Productos y combustibles | Grupo ARY" description="Conoce las estaciones, combustibles, lubricantes y productos complementarios de Grupo ARY." active="productos">
  <section class="page-hero"><div class="shell page-hero-grid"><div><span class="eyebrow light">Productos y soluciones</span><h1>El cuidado de tu auto <span class="accent-gold">nos importa.</span></h1><p>Todo comienza con una buena parada. Conoce nuestros productos y encuentra una estación para seguir tu trayecto.</p><div class="actions"><a class="button gold" href="#catalogo">Explora los productos ↓</a><a class="button outline" href="/estaciones/">Ubicar estación ↗</a></div></div><div class="page-hero-img"><img src="/media/ary-2.webp" alt="Gasolinería ARY con surtidores" width="1152" height="864" /></div></div></section>
  <section class="section blush" id="catalogo"><div class="shell"><span class="eyebrow">Conoce nuestra oferta</span><h2 class="section-title">Todo para continuar <span class="accent">tu viaje.</span></h2><p class="section-lead">Consulta los productos directamente con tu estación; la disponibilidad puede variar.</p><div class="product-grid" style="margin-top:32px">{products.map(item=><article class="product-card"><img src={item.image} alt={item.alt} loading="lazy" width="1152" height="864" /><div><span class="tag">{item.tag}</span><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></div></section>
  <section class="section compact white"><div class="shell feature-banner"><div><span class="eyebrow light">Tu ruta empieza aquí</span><h2>Encuentra tu estación ARY.</h2><p>Consulta las ubicaciones en Gómez Palacio, Lerdo y Torreón.</p></div><a class="button gold" href="/estaciones/">Ver estaciones ↗</a></div></section>
</SiteLayout>
