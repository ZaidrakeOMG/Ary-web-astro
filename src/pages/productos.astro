---
import SiteLayout from '../layouts/SiteLayout.astro';import PageIntro from '../components/PageIntro.astro';import Icon from '../components/Icon.astro';import CTA from '../components/CTA.astro';
const products=[['fuel','Combustibles','Localiza tu estación y consulta los combustibles disponibles para tu vehículo.'],['shield','Lubricantes','Pregunta por los productos de mantenimiento adecuados a las especificaciones de tu automóvil.'],['car','Complementos para tu auto','Consulta en estación la oferta de productos para acompañar tus recorridos diarios.']];
---
<SiteLayout title="Productos para tu vehículo | ARY" description="Conoce las categorías de productos y consulta su disponibilidad en nuestras estaciones." active="servicios">
<PageIntro eyebrow="CUIDA TU CAMINO" title="Tu auto merece" accent="seguir adelante." description="Combustibles y productos complementarios para el cuidado de tu vehículo. Consulta disponibilidad en tu estación."/>
<section class="section"><div class="wrap split-section"><img src="/media/ary-6.webp" alt="Fotografía nocturna de ARY VI" width="1152" height="864" loading="lazy"/><div><span class="overline">TODO EMPIEZA CON UNA BUENA PARADA</span><h2>Encuentra lo que tu <em>vehículo necesita.</em></h2><p>El personal de cada estación puede orientarte acerca de los productos que tiene disponibles. Sigue siempre las recomendaciones del fabricante de tu auto.</p><a class="button button-primary" href="/estaciones/">Ubica tu estación <Icon name="external" size={18}/></a></div></div></section>
<section class="section soft-bg"><div class="wrap services-grid">{products.map(([icon,title,text])=><article class="service-tile"><div class="tile-head"><span class="tile-icon"><Icon name={icon}/></span></div><h3>{title}</h3><p>{text}</p><a class="text-link" href="/contacto/">Consulta con nosotros <Icon name="arrow" size={18}/></a></article>)}</div></section><CTA/>
</SiteLayout>
