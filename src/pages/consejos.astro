---
import SiteLayout from '../layouts/SiteLayout.astro';import PageIntro from '../components/PageIntro.astro';import Icon from '../components/Icon.astro';import CTA from '../components/CTA.astro';
const tips=[['car','Conduce con suavidad','Anticipa el tránsito y evita acelerones o frenadas innecesarias.'],['shield','Revisa tus llantas','Comprueba la presión en frío y sigue la indicada por el fabricante.'],['clock','Cuida el mantenimiento','Respeta los intervalos de servicio y utiliza los productos recomendados para tu vehículo.'],['fuel','Verifica la tapa','Después de cargar, comprueba que la tapa del depósito quede correctamente cerrada.'],['pin','Organiza tus recorridos','Agrupa pendientes y evita desvíos o peso que no necesitas transportar.'],['leaf','Mantén un ritmo estable','Cuando las condiciones de seguridad lo permitan, evita cambios bruscos de velocidad.']];
---
<SiteLayout title="Consejos para el camino | ARY" description="Ideas para cuidar tu vehículo y aprovechar mejor tus recorridos.">
<PageIntro eyebrow="PEQUEÑOS HÁBITOS, MEJORES RECORRIDOS" title="Cada trayecto" accent="cuenta." description="Ideas sencillas para cuidar tu auto. Respeta siempre las indicaciones de su fabricante y las condiciones de seguridad."/>
<section class="section"><div class="wrap tip-grid">{tips.map(([icon,title,text])=><article class="tip-tile"><span class="tile-icon"><Icon name={icon}/></span><h3>{title}</h3><p>{text}</p></article>)}</div></section><CTA/>
</SiteLayout>
