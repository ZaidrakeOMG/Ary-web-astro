---
import SiteLayout from '../layouts/SiteLayout.astro';import PageIntro from '../components/PageIntro.astro';import policy from '../data/privacy.json';
const parts=policy.text.split(/(?= [1-6]\. )/);
---
<SiteLayout title="Aviso de privacidad | Grupo ARY" description="Política de privacidad publicada por Grupo ARY."><PageIntro eyebrow="GRUPO ARY" title="Aviso de" accent="privacidad." description="Consulta la política de privacidad del sitio."/><section class="section"><div class="wrap policy">{parts.map(p=><p>{p}</p>)}</div></section></SiteLayout>
