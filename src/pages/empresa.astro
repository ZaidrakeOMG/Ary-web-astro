---
import SiteLayout from '../layouts/SiteLayout.astro';import PageIntro from '../components/PageIntro.astro';import Icon from '../components/Icon.astro';import CTA from '../components/CTA.astro';
const values=[['pin','Cerca de ti','Somos parte de los recorridos de las personas y los negocios de la Comarca Lagunera.'],['person','Atención que acompaña','Queremos que cada visita sea una experiencia clara, cómoda y cercana.'],['car','Siempre en movimiento','Reunimos estaciones, servicios para vehículos y alternativas para la operación de flotillas.']];
---
<SiteLayout title="Conoce ARY | Gasolinerías en La Laguna" description="Conoce nuestras estaciones y soluciones para conductores, negocios y flotillas en La Laguna." active="empresa">
<PageIntro eyebrow="SOMOS ARY" title="Tu camino" accent="nos mueve." description="Más que estaciones de servicio: somos parte de tu día, tu negocio y tus próximos destinos."/>
<section class="section"><div class="wrap split-section"><img src="/media/ary-4.webp" alt="Fotografía de la estación ARY IV" width="1152" height="864" loading="lazy"/><div><span class="overline">NUESTRA HISTORIA CONTINÚA CONTIGO</span><h2>La energía de una región que <em>no se detiene.</em></h2><p>En Grupo ARY acompañamos a conductores, familias y empresas con estaciones de servicio en Gómez Palacio, Lerdo y Torreón.</p><p>Nuestra oferta reúne la atención en estación, productos para el vehículo y soluciones para flotillas y facturación.</p><div class="stat-row"><div><strong>7</strong><small>Estaciones ARY y Apache</small></div><div><strong>3</strong><small>Ciudades de La Laguna</small></div><div><strong>1</strong><small>Mismo compromiso contigo</small></div></div></div></div></section>
<section class="section soft-bg"><div class="wrap"><div class="section-top"><div><span class="overline">LO QUE NOS MUEVE</span><h2>Avanzamos mejor, <em>juntos.</em></h2></div></div><div class="services-grid">{values.map(([icon,title,text])=><article class="service-tile"><div class="tile-head"><span class="tile-icon"><Icon name={icon}/></span></div><h3>{title}</h3><p>{text}</p></article>)}</div></div></section><CTA/>
</SiteLayout>
