---
import SiteLayout from '../layouts/SiteLayout.astro';import PageIntro from '../components/PageIntro.astro';import Icon from '../components/Icon.astro';import CTA from '../components/CTA.astro';
const steps=[['01','Cuéntanos de tu negocio','Contacta a nuestro equipo e indica que buscas información de crédito o atención a flotillas.'],['02','Conoce los requisitos','Consulta la documentación y las condiciones necesarias para evaluar tu solicitud.'],['03','Recibe seguimiento','Nuestro equipo podrá orientarte sobre los siguientes pasos del proceso.']];
---
<SiteLayout title="Crédito empresarial y flotillas | ARY" description="Solicita información de crédito y servicios para flotillas con Grupo ARY." active="servicios">
<PageIntro eyebrow="TU NEGOCIO NO SE DETIENE" title="Impulsa tu" accent="operación." description="Conoce las alternativas de ARY para acompañar a tu empresa y organizar el consumo de tus vehículos."/>
<section class="section"><div class="wrap"><div class="section-top"><div><span class="overline">EMPECEMOS CON UNA CONVERSACIÓN</span><h2>Un siguiente paso <em>más claro.</em></h2><p>La aprobación de crédito está sujeta a evaluación y a las condiciones aplicables.</p></div></div><div class="services-grid">{steps.map(([n,title,text])=><article class="service-tile"><div class="tile-head"><span class="tile-icon">{n}</span></div><h3>{title}</h3><p>{text}</p></article>)}</div><div class="button-row"><a class="button button-primary" href="mailto:contacto@grupoary.com.mx?subject=Informaci%C3%B3n%20de%20cr%C3%A9dito%20ARY">Solicitar información <Icon name="mail" size={18}/></a><a class="button button-outline" href="/servicios/">Explorar servicios</a></div><p class="notice-box">Esta página abre tu aplicación de correo; no registra ni autoriza automáticamente una solicitud de crédito. El alta fiscal para facturación es un trámite independiente.</p></div></section><CTA title="¿Solo necesitas dar de alta tus datos fiscales?" description="No necesitas solicitar crédito para registrar tus datos de facturación." href="/facturacion/?tramite=alta" label="Alta de cliente"/>
</SiteLayout>
