---
import SiteLayout from '../layouts/SiteLayout.astro';
import StationCard from '../components/StationCard.astro';
import {stations, services} from '../data/site';
const featured=[stations[0],stations[2],stations[6]];
---
<SiteLayout title="Grupo ARY | Gasolinerías y soluciones para seguir avanzando" description="Gasolinerías Grupo ARY en Gómez Palacio, Lerdo y Torreón. Encuentra estaciones, servicios para flotillas, alta de clientes y facturación electrónica." active="inicio">
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <span class="eyebrow light">Gasolinerías Grupo ARY</span>
        <h1><span>Tu camino.</span><span>Tu energía.</span><span class="accent-gold">Nuestra pasión.</span></h1>
        <p>Cerca de ti cuando el camino llama. Estaciones de servicio, soluciones para flotillas y trámites más sencillos, todo en un mismo lugar.</p>
        <div class="actions"><a class="button gold" href="/estaciones/">Encuentra tu estación <span aria-hidden="true">↗</span></a><a class="button outline" href="/facturacion/">Facturar o darme de alta <span aria-hidden="true">▤</span></a></div>
        <div class="hero-chips"><span>7 ubicaciones</span><span>Durango y Coahuila</span><span>Facturación en línea</span></div>
      </div>
      <div class="hero-photo-wrap">
        <div class="hero-photo"><img src="/media/ary-3.webp" width="1152" height="864" alt="Estación ARY iluminada por la noche" fetchpriority="high" decoding="async" /><div class="photo-credit"><div><small>Tu próxima parada</small><strong>ARY Super Servicios</strong></div><span aria-hidden="true">↗</span></div></div>
        <div class="floating-mark"><img src="/media/ary-logo.webp" width="93" height="93" alt="" /><span>Siempre contigo</span></div>
      </div>
    </div>
  </section>
  <section class="ribbon" aria-label="Beneficios de Grupo ARY"><div class="shell ribbon-grid">
    <div class="ribbon-item"><span class="ribbon-icon" aria-hidden="true">⌖</span><div><strong>Estamos cerca de ti</strong><small>7 estaciones para tus recorridos</small></div></div>
    <div class="ribbon-item"><span class="ribbon-icon" aria-hidden="true">◈</span><div><strong>Soluciones para empresas</strong><small>Flotillas y control de consumos</small></div></div>
    <div class="ribbon-item"><span class="ribbon-icon" aria-hidden="true">▤</span><div><strong>Facturación digital</strong><small>Alta fiscal y tickets en un mismo portal</small></div></div>
  </div></section>
  <section class="section blush"><div class="shell">
    <div class="heading-row"><div><span class="eyebrow">A tu lado, siempre</span><h2 class="section-title">Todo lo que necesitas.<br /><span class="accent">Sin complicaciones.</span></h2><p class="section-lead">Queremos que cada parada sea el inicio de algo bueno. Conoce todo lo que Grupo ARY tiene para ti.</p></div><a class="text-link" href="/servicios/">Ver todos los servicios ↗</a></div>
    <div class="services-grid">{services.map(item=><article class="service-card"><span class="service-icon" aria-hidden="true">{item.icon}</span><span class="service-index">{item.id} / GRUPO ARY</span><h3>{item.title}</h3><p>{item.body}</p><a href={item.href}>Descubrir <span aria-hidden="true">→</span></a></article>)}</div>
  </div></section>
  <section class="section white"><div class="shell">
    <div class="heading-row"><div><span class="eyebrow">Encuentra tu próxima parada</span><h2 class="section-title">Siempre hay una ARY<br /><span class="accent">en tu camino.</span></h2><p class="section-lead">Conoce algunas de nuestras estaciones en la Comarca Lagunera.</p></div><a class="text-link" href="/estaciones/">Ver las 7 estaciones ↗</a></div>
    <div class="station-grid">{featured.map(station=><StationCard station={station} />)}</div>
    <div style="text-align:center;margin-top:34px"><a class="button outline-light" href="/estaciones/">Explorar todas las ubicaciones <span aria-hidden="true">↗</span></a></div>
  </div></section>
  <section class="section blush"><div class="shell split-grid">
    <div class="split-photo"><img src="/media/ary-2.webp" alt="Estación ARY de día" width="1152" height="864" loading="lazy" decoding="async" /></div>
    <div class="split-text"><span class="eyebrow">Conoce a Grupo ARY</span><h2>Mucho más que <span class="accent">combustible.</span></h2><p>Nuestras estaciones forman parte del día a día de familias, conductores y negocios de la región. Trabajamos para que tu experiencia sea más fácil, cercana y confiable.</p><a class="button magenta" href="/empresa/">Conoce nuestra empresa <span aria-hidden="true">↗</span></a></div>
  </div></section>
  <section class="section compact white"><div class="shell">
    <div class="feature-banner"><div><span class="eyebrow light">Tu trámite, donde estés</span><h2>Facturar nunca se vio tan fácil.</h2><p>Factura tu ticket o solicita tu alta fiscal. Revisa tus datos y consulta el estado de tu trámite desde tu celular.</p></div><a class="button gold" href="/facturacion/">Ir a facturación <span aria-hidden="true">↗</span></a></div>
  </div></section>
  <section class="section blush"><div class="shell mascot-bar"><img src="/media/ary-mascota.webp" alt="Mascota de Grupo ARY" loading="lazy" width="261" height="267" /><div><span class="eyebrow" style="margin-bottom:8px">Un consejo de ARY</span><h3>Cuida tu auto, disfruta el camino.</h3><p>Pequeños hábitos pueden hacer la diferencia en tus recorridos diarios.</p></div><a class="button magenta" href="/consejos/">Ver consejos ↗</a></div></section>
</SiteLayout>
