---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import AryAssistant from '../components/AryAssistant.astro';
interface Props { title: string; description: string; active?: string; billing?: boolean }
const { title, description, active = '', billing = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const csp = `default-src 'self'; base-uri 'none'; object-src 'none'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; script-src-attr 'none'; form-action 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; require-trusted-types-for 'script'; trusted-types 'none'`;
const nav=[['/','home','Inicio','inicio'],['/estaciones/','pin','Estaciones','estaciones'],['/facturacion/','receipt','Facturar','facturacion'],['/contacto/','help','Ayuda','contacto']];
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta name="theme-color" content="#951361"/>
    <meta name="ary-release" content="ary-pro-20261015-hardening-v4"/>
    <meta name="description" content={description}/>
    {billing && <meta http-equiv="Content-Security-Policy" content={csp}/>}
    {billing && <meta name="robots" content="noindex,nofollow"/>}
    <meta name="referrer" content={billing ? 'no-referrer' : 'strict-origin-when-cross-origin'}/>
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="es_MX"/>
    <meta property="og:image" content="https://www.grupoary.com.mx/media/ary-3.webp"/>
    <link rel="canonical" href={canonical}/><link rel="icon" type="image/webp" href="/media/ary-symbol.webp"/>
    <link rel="stylesheet" href="/styles/ary-chat.css?v=1"/>
    <link rel="stylesheet" href="/ary-assistance.css?v=2"/>
    <title>{title}</title>
  </head>
  <body class:list={[{ 'is-billing': billing }]}>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <Header active={active} billing={billing}/>
    <main id="contenido"><slot/></main>
    <Footer/>
    <nav class="bottom-nav" aria-label="Accesos rápidos">
      {nav.map(([href,icon,label,key]) => <a href={href} class:list={[{ selected: key === active }]} aria-current={key === active ? 'page' : undefined}><Icon name={icon} size={21}/><span>{label}</span></a>)}
    </nav>
    <slot name="scripts"/>
    <AryAssistant/>
    <script is:inline defer src="/scripts/ary-chat.js?v=3"></script>
    <script is:inline defer src="/scripts/ary-voice.js?v=4"></script>
    <script src="../scripts/ui.ts"></script>
  </body>
</html>
