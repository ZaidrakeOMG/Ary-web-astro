---
const { active = "" } = Astro.props;
const links = [
  { id: "inicio", label: "Inicio", href: "/" },
  { id: "empresa", label: "Nosotros", href: "/empresa/" },
  { id: "estaciones", label: "Estaciones", href: "/estaciones/" },
  { id: "servicios", label: "Servicios", href: "/servicios/" },
  { id: "productos", label: "Productos", href: "/productos/" },
  { id: "contacto", label: "Contacto", href: "/contacto/" },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Grupo ARY, ir al inicio">
      <span class="brand-icon"><img src="/Images/Arylogo2.png" alt="" width="44" height="44" /></span>
      <span class="brand-name"><strong>GRUPO ARY</strong><small>Super Servicios</small></span>
    </a>
    <nav class="desktop-links" aria-label="Navegación principal">
      {links.map(link => (
        <a class:list={["nav-link", { selected: active === link.id }]} href={link.href} aria-current={active === link.id ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>
    <a class:list={["nav-bill", { current: active === "facturacion" }]} href="/facturacion/">
      <span aria-hidden="true">▤</span> Facturación <span aria-hidden="true">↗</span>
    </a>
    <details class="mobile-menu">
      <summary aria-label="Abrir menú de navegación">
        <span class="menu-lines" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>Menú</span>
      </summary>
      <nav class="mobile-links" aria-label="Navegación móvil">
        {links.map(link => (
          <a href={link.href} aria-current={active === link.id ? "page" : undefined}>{link.label}<span aria-hidden="true">↗</span></a>
        ))}
        <a class="mobile-billing" href="/facturacion/">Facturación y alta de clientes <span aria-hidden="true">↗</span></a>
        <a href="/credito/">Solicitar información de crédito <span aria-hidden="true">↗</span></a>
      </nav>
    </details>
  </div>
</header>
