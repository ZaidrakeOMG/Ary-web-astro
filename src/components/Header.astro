---
const {active = ''} = Astro.props;
const menu = [
  {href:'/',label:'Inicio',id:'inicio'},
  {href:'/empresa/',label:'Nosotros',id:'empresa'},
  {href:'/estaciones/',label:'Estaciones',id:'estaciones'},
  {href:'/servicios/',label:'Servicios',id:'servicios'},
  {href:'/productos/',label:'Productos',id:'productos'},
  {href:'/contacto/',label:'Contacto',id:'contacto'},
];
---
<header class="site-header">
  <div class="shell header-inner">
    <a href="/" class="brand" aria-label="Grupo ARY, inicio">
      <img src="/media/ary-symbol.webp" alt="" width="37" height="44" fetchpriority="high" />
      <span class="brand-copy"><strong>ARY</strong><small>GASOLINERÍAS</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Navegación principal">
      {menu.map(link => <a href={link.href} aria-current={active===link.id?'page':undefined}>{link.label}</a>)}
    </nav>
    <a href="/facturacion/" class="header-cta">Facturación <span aria-hidden="true">↗</span></a>
    <details class="mobile-menu">
      <summary aria-label="Abrir menú de navegación"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span><span>Menú</span></summary>
      <nav class="mobile-dropdown" aria-label="Navegación móvil">
        {menu.map(link => <a href={link.href} aria-current={active===link.id?'page':undefined}>{link.label}<span aria-hidden="true">↗</span></a>)}
        <a href="/consejos/">Consejos <span aria-hidden="true">↗</span></a>
        <a href="/credito/">Crédito y flotillas <span aria-hidden="true">↗</span></a>
        <a class="dropdown-special" href="/facturacion/">Facturación y alta <span aria-hidden="true">↗</span></a>
      </nav>
    </details>
  </div>
</header>
