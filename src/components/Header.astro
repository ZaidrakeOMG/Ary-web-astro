---
import Icon from './Icon.astro';
interface Props { active?: string; billing?: boolean }
const { active = '', billing = false } = Astro.props;
const links = [['/','Inicio','inicio'],['/empresa/','Nosotros','empresa'],['/estaciones/','Estaciones','estaciones'],['/servicios/','Servicios','servicios'],['https://www.grupoary.com.mx:4443/','Flotillas','flotillas'],['/contacto/','Contacto','contacto']];
---
<header class="site-header" data-billing={billing ? 'true' : 'false'}>
  <div class="wrap header-row">
    <a href="/" class="brand" aria-label="ARY Gasolinerías, inicio">
      <img id="brandLogo" src="/media/ary-symbol.webp" width="40" height="49" alt="" fetchpriority="high"/>
      <span id="brandFallback" hidden>ARY</span>
      <span class="brand-word"><strong>ARY<span class="brand-dot">.</span></strong><small>GASOLINERÍAS</small></span>
    </a>
    <nav id="mainNav" class="nav" aria-label="Navegación principal">
      {links.map(([href,label,key]) => <a href={href} aria-current={active === key ? 'page' : undefined}>{label}</a>)}
      <a class="nav-mobile-only" href="/productos/">Productos</a>
      <a class="nav-mobile-only" href="/consejos/">Consejos</a>
      <a class="nav-mobile-only" href="/facturacion/">Facturación y alta</a>
    </nav>
    <a class="button button-primary header-cta" href="/facturacion/"><Icon name="receipt" size={18}/> Facturación <Icon name="external" size={17}/></a>
    <button id="menuButton" class="menu-button" aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menú" type="button"><Icon name="menu"/><span>Menú</span></button>
  </div>
</header>
