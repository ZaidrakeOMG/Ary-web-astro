<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
        <add value="indext.html" />
        <add value="default.htm" />
        <add value="default.html" />
        <add value="Login.aspx" />
        <add value="Default.asp" />
        <add value="index.htm" />
        <add value="iisstart.htm" />
        <add value="default.aspx" />
      </files>
    </defaultDocument>

    <handlers>
      <add name="StaticFile-HTM" path="*.htm" verb="*" modules="StaticFileModule" resourceType="File" />
    </handlers>

<rewrite>
  <rules>
    <rule name="Redirect HTTP to HTTPS" stopProcessing="true">
      <match url="(.*)" />
      <conditions>
        <add input="{HTTPS}" pattern="^OFF$" />
        <add input="{REQUEST_URI}" pattern="^/.well-known/acme-challenge/" negate="true" />
      </conditions>
      <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
    </rule>
                <rule name="ARY Portal Facturacion API" stopProcessing="true">
                    <match url="^api/facturacion/(opciones|solicitudes|estado|recepcion)$" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^on$" />
                        <add input="{HTTP_HOST}" pattern="^www\.grupoary\.com\.mx(:443)?$" />
                    </conditions>
                    <serverVariables>
                        <set name="HTTP_X_ARY_CLIENT_IP" value="{REMOTE_ADDR}" />
                        <set name="HTTP_X_ARY_PROXY_HTTPS" value="on" />
                    </serverVariables>
                    <action type="Rewrite" url="http://10.20.20.182:8765/api/facturacion/{R:1}" appendQueryString="false" />
                </rule>
    <rule name="ARY Astro - Inicio" stopProcessing="true">
      <match url="^(?:default|default_01|defaultori|indext)\.htm$" ignoreCase="true" />
      <action type="Redirect" url="/" redirectType="Found" appendQueryString="false" />
    </rule>
    <rule name="ARY Astro - Empresa" stopProcessing="true">
      <match url="^ary_conoce_nuestra_empresa\.htm$" ignoreCase="true" />
      <action type="Redirect" url="/empresa/" redirectType="Found" appendQueryString="false" />
    </rule>
    <rule name="ARY Astro - Estaciones" stopProcessing="true">
      <match url="^ary_ubica_nuestras_estaciones\.htm$" ignoreCase="true" />
      <action type="Redirect" url="/estaciones/" redirectType="Found" appendQueryString="false" />
    </rule>
    <rule name="ARY Astro - Servicios" stopProcessing="true">
      <match url="^(?:ary_servicios|ary-superservicios)\.htm$" ignoreCase="true" />
      <action type="Redirect" url="/servicios/" redirectType="Found" appendQueryString="false" />
    </rule>
    <rule name="ARY Astro - Productos" stopProcessing="true">
      <match url="^ary_productos\.htm$" ignoreCase="true" />
      <action type="Redirect" url="/productos/" redirectType="Found" appendQueryString="false" />
    </rule>
    <rule name="ARY Astro - Contacto" stopProcessing="true">
      <match url="^ary_contacto\.htm$" ignoreCase="true" />
      <action type="Redirect" url="/contacto/" redirectType="Found" appendQueryString="false" />
    </rule>
    <rule name="ARY Astro - Consejos" stopProcessing="true">
      <match url="^ary_tips_ahorro_combustible\.htm$" ignoreCase="true" />
      <action type="Redirect" url="/consejos/" redirectType="Found" appendQueryString="false" />
    </rule>
    <rule name="ARY Astro - Credito" stopProcessing="true">
      <match url="^ary_servicios_solicitud_credito\.htm$" ignoreCase="true" />
      <action type="Redirect" url="/credito/" redirectType="Found" appendQueryString="false" />
    </rule>
    <rule name="ARY Astro - Facturacion" stopProcessing="true">
      <match url="^(?:ary_facturacion|ary_facturacion-electronica|ary_facturacion-electronica_incluye boton)\.htm$" ignoreCase="true" />
      <action type="Redirect" url="/facturacion/" redirectType="Found" appendQueryString="false" />
    </rule>
    <rule name="ARY Astro - Privacidad" stopProcessing="true">
      <match url="^(?:ary_politica_de_privacidad|politica_de_privacidad)\.htm$" ignoreCase="true" />
      <action type="Redirect" url="/privacidad/" redirectType="Found" appendQueryString="false" />
    </rule>
    <rule name="ARY Astro - Gracias" stopProcessing="true">
      <match url="^(?:ary_gracias|gracias)\.htm$" ignoreCase="true" />
      <action type="Redirect" url="/gracias/" redirectType="Found" appendQueryString="false" />
    </rule>
    <rule name="ARY Astro - Error" stopProcessing="true">
      <match url="^(?:ary_error|error2)\.htm$" ignoreCase="true" />
      <action type="Redirect" url="/error/" redirectType="Found" appendQueryString="false" />
    </rule>
  </rules>
</rewrite>
  </system.webServer>
</configuration>
