<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true"><files><clear /><add value="index.html" /></files></defaultDocument>

    <handlers>
      <add name="StaticFile-HTM" path="*.htm" verb="*" modules="StaticFileModule" resourceType="File" />
    </handlers>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), geolocation=(), microphone=(self), payment=(), usb=(), display-capture=(), fullscreen=(self)" />
        <remove name="Strict-Transport-Security" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <remove name="Cross-Origin-Opener-Policy" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <remove name="Cross-Origin-Resource-Policy" />
        <add name="Cross-Origin-Resource-Policy" value="same-origin" />
        <remove name="Origin-Agent-Cluster" />
        <add name="Origin-Agent-Cluster" value="?1" />
        <remove name="X-Download-Options" />
        <add name="X-Download-Options" value="noopen" />
        <remove name="X-Permitted-Cross-Domain-Policies" />
        <add name="X-Permitted-Cross-Domain-Policies" value="none" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="ARY_CSP_PLACEHOLDER" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="5242880" maxUrl="2048" maxQueryString="1024" />
        <verbs allowUnlisted="true">
          <remove verb="TRACE" /><add verb="TRACE" allowed="false" /><remove verb="TRACK" /><add verb="TRACK" allowed="false" /><remove verb="CONNECT" /><add verb="CONNECT" allowed="false" />
          <remove verb="PUT" /><add verb="PUT" allowed="false" /><remove verb="DELETE" /><add verb="DELETE" allowed="false" /><remove verb="PATCH" /><add verb="PATCH" allowed="false" />
          <remove verb="PROPFIND" /><add verb="PROPFIND" allowed="false" /><remove verb="PROPPATCH" /><add verb="PROPPATCH" allowed="false" /><remove verb="MKCOL" /><add verb="MKCOL" allowed="false" />
          <remove verb="COPY" /><add verb="COPY" allowed="false" /><remove verb="MOVE" /><add verb="MOVE" allowed="false" /><remove verb="LOCK" /><add verb="LOCK" allowed="false" /><remove verb="UNLOCK" /><add verb="UNLOCK" allowed="false" />
        </verbs>
        <hiddenSegments>
          <remove segment=".git" /><add segment=".git" /><remove segment=".github" /><add segment=".github" /><remove segment=".ary-releases" /><add segment=".ary-releases" /><remove segment=".ary-staging" /><add segment=".ary-staging" />
          <remove segment="node_modules" /><add segment="node_modules" /><remove segment="server" /><add segment="server" /><remove segment="scripts" /><add segment="scripts" /><remove segment="tests" /><add segment="tests" />
          <remove segment="legacy" /><add segment="legacy" /><remove segment="docs" /><add segment="docs" /><remove segment="paquete-publicacion" /><add segment="paquete-publicacion" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <remove fileExtension=".env" /><add fileExtension=".env" allowed="false" /><remove fileExtension=".config" /><add fileExtension=".config" allowed="false" />
          <remove fileExtension=".ps1" /><add fileExtension=".ps1" allowed="false" /><remove fileExtension=".bat" /><add fileExtension=".bat" allowed="false" />
          <remove fileExtension=".py" /><add fileExtension=".py" allowed="false" /><remove fileExtension=".mjs" /><add fileExtension=".mjs" allowed="false" /><remove fileExtension=".ts" /><add fileExtension=".ts" allowed="false" />
          <remove fileExtension=".map" /><add fileExtension=".map" allowed="false" /><remove fileExtension=".sql" /><add fileExtension=".sql" allowed="false" />
          <remove fileExtension=".sqlite" /><add fileExtension=".sqlite" allowed="false" /><remove fileExtension=".sqlite3" /><add fileExtension=".sqlite3" allowed="false" /><remove fileExtension=".db" /><add fileExtension=".db" allowed="false" />
          <remove fileExtension=".log" /><add fileExtension=".log" allowed="false" /><remove fileExtension=".bak" /><add fileExtension=".bak" allowed="false" /><remove fileExtension=".old" /><add fileExtension=".old" allowed="false" />
          <remove fileExtension=".zip" /><add fileExtension=".zip" allowed="false" /><remove fileExtension=".rar" /><add fileExtension=".rar" allowed="false" /><remove fileExtension=".7z" /><add fileExtension=".7z" allowed="false" />
          <remove fileExtension=".key" /><add fileExtension=".key" allowed="false" /><remove fileExtension=".pem" /><add fileExtension=".pem" allowed="false" /><remove fileExtension=".pfx" /><add fileExtension=".pfx" allowed="false" /><remove fileExtension=".p12" /><add fileExtension=".p12" allowed="false" />
          <remove fileExtension=".json" /><add fileExtension=".json" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

<rewrite>
  <rules>
    <rule name="Redirect HTTP to HTTPS" stopProcessing="true">
      <match url="(.*)" />
      <conditions>
        <add input="{HTTPS}" pattern="^OFF$" />
        <add input="{REQUEST_URI}" pattern="^/.well-known/acme-challenge/" negate="true" />
      </conditions>
      <action type="Redirect" url="https://www.grupoary.com.mx/{R:1}" redirectType="Permanent" />
    </rule>
                <rule name="ARY Portal Facturacion API" stopProcessing="true">
                    <match url="^api/facturacion/(opciones|solicitudes|estado|recepcion)$" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^on$" />
                        <add input="{HTTP_HOST}" pattern="^www\.grupoary\.com\.mx(:443)?$" />
                    </conditions>
                    <serverVariables>
                        <set name="HTTP_X_ARY_CLIENT_IP" value="{REMOTE_ADDR}" />
                        <set name="HTTP_X_ARY_PROXY_HTTPS" value="on" />
                    </serverVariables>
                    <action type="Rewrite" url="http://10.20.20.182:8765/api/facturacion/{R:1}" appendQueryString="false" />
                </rule>
  </rules>
</rewrite>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <directoryBrowse enabled="false" />
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
  </system.webServer>
</configuration>
