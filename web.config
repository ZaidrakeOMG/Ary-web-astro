<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="indext.html" />
        <add value="default.htm" />
        <add value="default.html" />
        <add value="Login.aspx" />
        <add value="Default.asp" />
        <add value="index.htm" />
        <add value="index.html" />
        <add value="iisstart.htm" />
        <add value="default.aspx" />
      </files>
    </defaultDocument>

    <handlers>
      <add name="StaticFile-HTM" path="*.htm" verb="*" modules="StaticFileModule" resourceType="File" />
    </handlers>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), geolocation=(), microphone=(self), payment=(), usb=(), display-capture=(), fullscreen=(self)" />
        <remove name="Strict-Transport-Security" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <remove name="Cross-Origin-Opener-Policy" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin-allow-popups" />
        <remove name="X-Permitted-Cross-Domain-Policies" />
        <add name="X-Permitted-Cross-Domain-Policies" value="none" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; upgrade-insecure-requests" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="5242880" />
      </requestFiltering>
    </security>

<rewrite>
  <rules>
    <rule name="Redirect HTTP to HTTPS" stopProcessing="true">
      <match url="(.*)" />
      <conditions>
        <add input="{HTTPS}" pattern="^OFF$" />
        <add input="{REQUEST_URI}" pattern="^/.well-known/acme-challenge/" negate="true" />
      </conditions>
      <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
    </rule>
                <rule name="ARY Portal Facturacion API" stopProcessing="true">
                    <match url="^api/facturacion/(opciones|solicitudes|estado|recepcion)$" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^on$" />
                        <add input="{HTTP_HOST}" pattern="^www\.grupoary\.com\.mx(:443)?$" />
                    </conditions>
                    <serverVariables>
                        <set name="HTTP_X_ARY_CLIENT_IP" value="{REMOTE_ADDR}" />
                        <set name="HTTP_X_ARY_PROXY_HTTPS" value="on" />
                    </serverVariables>
                    <action type="Rewrite" url="http://10.20.20.182:8765/api/facturacion/{R:1}" appendQueryString="false" />
                </rule>
  </rules>
</rewrite>
  </system.webServer>
</configuration>
